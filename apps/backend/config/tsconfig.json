{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["../src/**/*.ts", "../scripts/**/*.ts", "../tests/**/*.ts"]
}
