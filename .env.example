# Dev: npm run setup generates .env with a random local PostgreSQL password.
# Staging/production: inject role-specific values into runtime.env and migration.env.
# Required: dev, staging, or production.
APP_ENV=dev
# Required: use sslmode=verify-full on staging/production.
DATABASE_URL=postgresql://alumni:REPLACE_ME@127.0.0.1:55432/alumni
# Optional: application bind address and port. Compose sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8081
# Optional: debug, info, warn, or error.
LOG_LEVEL=info
# Optional: defaults for npm run start. Release image sets both automatically.
APP_VERSION=0.1.0
COMMIT_SHA=local
# Required only for local Compose database. APP_ENV=dev only.
POSTGRES_PASSWORD=REPLACE_ME
# Optional local ports published to loopback by Compose.
DEV_DB_PORT=55432
HTTP_PORT=8080
# Optional: npm run admin connects to the backend started by npm run dev.
ADMIN_PORT=8082
BACKEND_PORT=8081
# Chỉ bật để kiểm thử local. Tạo mật khẩu bằng npm run local:accounts.
LOCAL_AUTH_ENABLED=false
#LOCAL_ADMIN_PASSWORD=
#LOCAL_ALUMNI_PASSWORD=
# Optional local-only account for the university content approval flow.
# LOCAL_REVIEWER_PASSWORD=
# Staging/production runtime secrets. Staff passwords must be distinct and 24 to 128 characters.
# STAFF_ADMIN_PASSWORD=
# STAFF_REVIEWER_PASSWORD=
# Web SEO on release hosts. Set an HTTPS origin with no path and enable indexing only on the public production domain.
# PUBLIC_SITE_URL=
# PUBLIC_INDEXING_ENABLED=false
# Required for Linux release commands. Use separate values on each host.
# RUNTIME_ENV_FILE=/etc/alumni-hub/runtime.env
# MIGRATION_ENV_FILE=/etc/alumni-hub/migration.env
# COMPOSE_PROJECT_NAME=alumni-staging
# Optional Linux host override, for example when mounting a custom database CA.
# COMPOSE_OVERRIDE_FILE=/etc/alumni-hub/compose.override.yaml
# RELEASE_STATE_DIR=/var/lib/alumni-hub/releases
# Required for deploy/backup.sh. Optional PGSERVICEFILE points to a libpq service file.
# BACKUP_DIR=/var/lib/alumni-hub/backups
# PGSERVICE=alumni-production-backup
# PGSERVICEFILE=/etc/alumni-hub/pg_service.conf
